rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // ---------- PUBLIC READ / ADMIN WRITE ----------
    match /products/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /brands/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /deliveryZones/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}      { allow read: if true; allow write: if isAdmin(); }

    match /coupons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- REVIEWS ----------
    match /reviews/{id} {
      allow read: if resource.data.isApproved == true || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // ---------- ORDERS ----------
    match /orders/{id} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if true;      // guest checkout allowed
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- USERS ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Anyone can create their own profile on signup, but not as admin —
      // ensureUserProfile() always writes role: 'customer', so this just
      // blocks a forged client-side write from creating an admin account.
      allow create: if isOwner(uid) && request.resource.data.role == 'customer';
      // An owner can update their own profile (name, phone, addresses...)
      // but NOT their own role — only an existing admin can grant or
      // revoke admin status. Without this, role became a plain writable
      // field the moment it replaced custom claims as the source of
      // truth, and any signed-in user could self-promote to admin.
      allow update: if isAdmin()
        || (isOwner(uid) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ---------- NOTIFICATIONS ----------
    match /notifications/{id} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // deny everything else
    match /{document=**} { allow read, write: if false; }
  }
}
